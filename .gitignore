# Generated at runtime by ad-hoc agent detection: the app merges a
# SessionStart hook into <cwd>/.claude/settings.local.json for a terminal's
# working dir. Machine-specific (per-launch token + localhost URL) — never commit.
**/.claude/settings.local.json

# === NEVER PUSH — local screenshots ===
# A local scratch folder for screenshots. It is NOT part of the repo and must
# never be committed or pushed. Do not remove this rule.
issues/

# This project is Rust + TypeScript only. Committed fixtures are test data; a
# throwaway generator script is not. Keep the repo Python-free; port such tooling
# to Rust if reproducible regeneration is ever needed.
*.py

# === Local working notes — never commit ===
.claude/private/

# === OS ===
.DS_Store
Thumbs.db

# === Node / frontend ===
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Test artifacts ===
# Regenerated by every `npm run test:coverage`. Tracking it means every test run
# dirties ~20 HTML files and buries real diffs. CI uploads it as an artifact.
coverage/

# Written by the layer-5 browser tier (vitest.browser.config.ts) on a failing
# run: a screenshot of the page and any attachments. Useful locally and as a CI
# artifact, but they are regenerated every run and must not be tracked.
**/__screenshots__/
.vitest-attachments/

# === Rust / Tauri core ===
/src-tauri/target/
target/
# Generated by Tauri at build time — must not be tracked
/src-tauri/gen/schemas/
**/*.rs.bk
*.pdb

# === Env / secrets ===
.env
.env.*
!.env.example

# === Editor / misc ===
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# cargo-mutants output (mutation-testing artifacts)
mutants.out/
**/mutants.out/

# Key material — never commit
*.pem
*.key
*.p12
*.pfx
*.crt

# Markdown is ignored by default. Only the README and the technical docs listed here are published;
# adding a file to this list is a deliberate decision, and the file must hold no real data.
# Enforced by scripts/repo-hygiene.test.mjs.
*.md
!/README.md
!/docker/db-fixtures/README.md
!/docs/design/ARCHITECTURE.md
!/docs/design/agent-restart-restore.md
!/docs/design/code-intelligence.md
!/docs/design/csp.md
!/docs/design/e2e-flow-catalog.md
!/docs/design/editor-syntax-highlighting.md
!/docs/design/file-icons.md
!/docs/design/language-detection.md
!/docs/design/sql-to-mongo.md
!/docs/design/tab-tearoff.md
!/docs/design/testing-strategy.md
!/e2e/README.md
!/src-tauri/vendor/portable-pty/UPSTREAM-PATCH.md
!/src/assets/file-icons/README.md
!/src/assets/pixel-agents/README.md

