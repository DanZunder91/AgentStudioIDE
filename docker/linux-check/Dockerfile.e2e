# Ubuntu WebDriver E2E image — drives the REAL built app with tauri-driver + WebKitWebDriver
# under xvfb, because Tauri WebDriver cannot run on macOS (Apple has no WKWebView driver) and
# the E2E runs locally. Used by scripts/e2e-linux.mjs.
#
# Everything here is a DEV-IMAGE dependency, never a user install: the Tauri build deps (same
# set as ./Dockerfile and .github/workflows/e2e.yml), the WebKit WebDriver, a virtual display,
# curl (the network spec's client inside the IDE terminal), wget (real-service-external's client
# that does NOT read the IDE's CA — the never-break check), Node 22 for wdio, and tauri-driver
# pinned to the version CI installs. python3 (stdlib urllib only) is the gazelle-like scenario's
# fake agent: it calls the fixture with `NO_PROXY=*`, the way a real agent does.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev \
      libayatana-appindicator3-dev librsvg2-dev pkg-config ca-certificates iproute2 procps git \
      patchelf webkit2gtk-driver xvfb xauth dbus-x11 xz-utils fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.97.1
ENV PATH=/root/.cargo/bin:$PATH
RUN cargo install tauri-driver@2.0.6 --locked && rm -rf /root/.cargo/registry
# Node 22.23.5, from the official tarball. WebdriverIO 10 needs >=22.23.4 (its `engines`);
# the app itself still builds on Node 22.20.
ARG NODE_VERSION=22.23.5
RUN arch="$(dpkg --print-architecture)"; case "$arch" in amd64) n=x64;; arm64) n=arm64;; *) exit 1;; esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${n}.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1
# Its own layer (after the slow ones, so adding it did not rebuild them).
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
# Recording + window tooling (scripts/e2e-linux.mjs --record, e2e/support/record.ts and x11.ts).
# ffmpeg grabs the WHOLE virtual display (x11grab -> H.264 mp4, a GIF, PNG stills), so a second OS
# window — a torn-off tab — is in the picture, not only the WebDriver viewport. openbox is a tiny
# window manager, started only while recording: it places a new window beside the main one and draws
# title bars, so a viewer can tell the windows apart. xdotool drives the one gesture WebDriver cannot
# (a real X11 drag of a tab out of its window); x11-utils' xwininfo lists the OS windows for an
# assertion that does not go through any webview. Own layer, last: adding it rebuilt nothing above.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg openbox xdotool x11-utils \
    && rm -rf /var/lib/apt/lists/*
# The IDE's terminals spawn $SHELL; make it deterministic.
ENV SHELL=/bin/bash
WORKDIR /repo
