[
  {
    "id": "postgres",
    "family": "postgres",
    "label": "PostgreSQL",
    "defaultPort": 5432,
    "urlSchemes": [
      "postgresql",
      "postgres"
    ],
    "databaseLabel": "Database",
    "supportsUser": true,
    "sslModes": [
      "disable",
      "prefer",
      "require",
      "verify-ca",
      "verify-full"
    ],
    "extraFields": [
      {
        "key": "applicationName",
        "label": "Application name",
        "kind": "text",
        "placeholder": "Agent Studio",
        "choices": null,
        "default": "Agent Studio",
        "required": false,
        "hint": "Appears in pg_stat_activity, so a runaway query is traceable back to this app."
      },
      {
        "key": "searchPath",
        "label": "Search path",
        "kind": "text",
        "placeholder": "public",
        "choices": null,
        "default": "",
        "required": false,
        "hint": "Which schemas an unqualified table name resolves against."
      },
      {
        "key": "connectTimeout",
        "label": "Connect timeout (s)",
        "kind": "number",
        "placeholder": "10",
        "choices": null,
        "default": "",
        "required": false,
        "hint": "Bounds the dial itself; the query timeout is set separately below."
      },
      {
        "key": "targetSessionAttrs",
        "label": "Target session",
        "kind": "select",
        "placeholder": null,
        "choices": [
          "any",
          "read-write",
          "read-only",
          "primary",
          "standby",
          "prefer-standby"
        ],
        "default": "",
        "required": false,
        "hint": "For a multi-host cluster: which member to accept. `read-only` steers analytical queries onto a replica."
      }
    ],
    "defaults": {
      "rowLimit": 500,
      "timeoutMs": 30000,
      "allowMultiStatement": false,
      "sslMode": "prefer"
    },
    "serverEnforcedReadOnly": true,
    "queryLanguage": "sql"
  },
